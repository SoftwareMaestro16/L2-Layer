    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.15.30",
    "@vitejs/plugin-vue": "^6.0.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.8"
  }
