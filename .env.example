L2_NAME=Entropis
L2_CHAIN_ID=entropis-testnet
L2_NATIVE_TOKEN_NAME=Entropis
L2_NATIVE_TOKEN_SYMBOL=ENT
L2_NODE_ADDR=127.0.0.1:8080
L2_CHALLENGE_WINDOW_SEC=300
ENT_FAUCET_AMOUNT=1000
ENT_DECIMALS=9
ENT_LOGO_PATH=assets/entropis.png
ENT_FAUCET_REQUIRE_ADMIN=true
L2_DEV_ADMIN_DEPOSITS_ENABLED=true

L1_DEPOSIT_INDEXER_ENABLED=false
L1_VAULT_ADDRESS=
L1_DEPOSIT_POLL_INTERVAL_MS=5000
L1_DEPOSIT_BATCH_LIMIT=100
L1_DEPOSIT_CONFIRMATION_LAG_LT=0
L1_TON_ASSET_ID=1
L1_DEPOSIT_ASSET_IDS=1

L1_BATCH_RELAYER_ENABLED=false
L1_ROLLUP_ROOT_ADDRESS=
L1_SEQUENCER_SENDER_ADDRESS=
L1_COMMIT_SIGNER_ENDPOINT=
L1_COMMIT_SIGNER_TOKEN=
L1_COMMIT_MSG_VALUE_NANOTON=100000000
L1_BATCH_RELAYER_POLL_INTERVAL_MS=5000
L1_BATCH_RELAYER_RETRY_BACKOFF_MS=15000
L1_BATCH_RELAYER_MAX_ATTEMPTS=8

TON_NETWORK=testnet
TONCENTER_V3_BASE_URL=https://testnet.toncenter.com/api/v3
TONCENTER_API_KEY=replace-with-toncenter-testnet-key
TONAPI_BASE_URL=https://testnet.tonapi.io
TONAPI_KEY=replace-with-tonapi-testnet-key

DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://default:password@host:6379
L2_ADMIN_TOKEN=replace-with-random-admin-token
